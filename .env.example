# Copia este archivo a ".env" (junto a docker-compose.yml) y completa los valores.
# NUNCA subas el .env real a git.

# Base de datos
DB_PASSWORD=
DB_NAME=goldreef_db
# Tras el primer despliegue (tablas creadas) puedes poner false
DB_SYNCHRONIZE=true

# Seguridad (genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Dominios permitidos por CORS (separados por coma)
CORS_ORIGINS=https://goldreefautos.com,https://www.goldreefautos.com

# Carga el catalogo inicial de vehiculos si la base esta vacia
SEED_DEMO_DATA=true

# Un usuario por rol (se crean al primer arranque si no existen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
CONCESIONARIA_EMAIL=
CONCESIONARIA_PASSWORD=
AGENTE_EMAIL=
AGENTE_PASSWORD=
CLIENTE_EMAIL=
CLIENTE_PASSWORD=
